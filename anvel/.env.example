# Copy these into Vercel -> Project -> Settings -> Environment Variables
# (Production + Preview), or into a local .env for `vercel dev`.

# Postgres connection string. On Vercel: Dashboard -> Storage -> Create ->
# Postgres, then copy POSTGRES_URL. Neon / Supabase connection strings work
# too. Without this, Anvel falls back to an ephemeral local SQLite file so
# sign-up can be smoke-tested — data will not be shared between instances.
POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Optional. Override the SQLite fallback file path (default:
# /tmp/anvel-vercel.db on Vercel, ./anvel-vercel.db locally).
# ANVEL_DB_PATH=/tmp/anvel.db
