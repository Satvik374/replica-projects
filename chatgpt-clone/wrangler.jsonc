{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marlowe",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Local development only. The Sites deployment injects the real DB binding;
  // this block just gives `wrangler dev` a local database to talk to.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marlowe",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
